def classify_incident(description):

    categories = {
        "Phishing": ["email", "fake link", "password", "attachment"],
        "Unpatched Vulnerability": ["unpatched", "software flaw",
                                    "outdated", "vulnerability"],
        "Misconfiguration": ["misconfigured", "open port",
                             "default password", "wrong settings"],
        "Insider Threat": ["employee", "staff", "insider",
                           "unauthorized access"],
        "Supply-Chain Compromise": ["vendor", "third-party",
                                    "supplier", "software update"]
    }

    description = description.lower()

    scores = {}

    for category, keywords in categories.items():
        scores[category] = sum(
            keyword in description for keyword in keywords
        )

    result = max(scores, key=scores.get)

    if scores[result] == 0:
        print("Root Cause: Unknown")
    else:
        print("Root Cause Category:", result)


incident = input("Enter incident description: ")

classify_incident(incident)
